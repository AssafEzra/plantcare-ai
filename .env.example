# PlantCare AI — environment variable NAMES only. Never commit real values.
# Copy to .env and fill in from your DEV Supabase project.
# See docs/ENVIRONMENTS.md for which environment owns which value.

# --- Application ---
APP_ENV=development
APP_DEBUG=true
DEFAULT_TIMEZONE=Asia/Jerusalem
DEFAULT_CONTENT_LANGUAGE=he

# --- Supabase (DEV project only for local development) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=plant-images
# Used by the Supabase CLI (`supabase config push`, `db push`) and the integration
# tests, which connect to Postgres directly. Not read by the application itself,
# which is why it was missing from this template until PR AI_provider.
SUPABASE_DB_PASSWORD=

# --- AI providers ---
# Vendor and model are chosen per agent, so two vendors can be compared on the
# same work. Providers: anthropic | google | openai
#
# The provider name is validated at startup - a typo refuses to boot. The model
# string is passed to the vendor untouched, so a model released after this code
# was written needs no code change; a wrong one fails at the first call with the
# vendor's own reason, before any generation, and costs nothing.
IDENTIFICATION_PROVIDER=anthropic
KNOWLEDGE_PROVIDER=anthropic
CARE_PROVIDER=anthropic
HEALTH_PROVIDER=anthropic

IDENTIFICATION_MODEL=claude-opus-5
KNOWLEDGE_MODEL=claude-opus-5
CARE_MODEL=claude-opus-5
HEALTH_MODEL=claude-opus-5

# One credential per vendor. Only the vendors you actually configure need one.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
# Deprecated single-provider name, still accepted as a fallback for
# ANTHROPIC_API_KEY so a deployment configured under the old name keeps working.
# Remove once no environment sets it.
AI_API_KEY=
# Per-agent, because the four do work of very different sizes. Knowledge writes
# thirteen sections of Hebrew prose and needs minutes; identification is a vision
# call measured at about thirty seconds. AI_REQUEST_TIMEOUT_SECONDS remains the
# client default for calls that are not agent-scoped.
AI_REQUEST_TIMEOUT_SECONDS=90
IDENTIFICATION_TIMEOUT_SECONDS=90
KNOWLEDGE_TIMEOUT_SECONDS=600
CARE_TIMEOUT_SECONDS=180
HEALTH_TIMEOUT_SECONDS=180
AI_MAX_STRUCTURED_RETRIES=2

# --- Email (Resend). Optional: falls back to a null provider when unset. ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Internal scheduler tick endpoint ---
INTERNAL_TICK_SECRET=
# How often the API runs the scheduler sweep itself, in seconds. 0 disables it.
# Use 0 where something else calls POST /v1/internal/tick - on Cloud Run that is
# Cloud Scheduler, because a timer inside a process that has scaled to zero runs
# no sweep at all.
INTERNAL_TICK_INTERVAL_SECONDS=900

# --- The built interface ---
# Where `npm run build` left frontend/dist. Set it and the API serves the
# application from the same origin as /v1, which is what the container does.
# Leave it empty for local development: Vite serves the app on :5173 and proxies
# /v1 to this API, so the browser still sees one origin.
# SPA_DIST_DIR=

# --- Rate limits for AI-triggering endpoints (A14) ---
AI_RATE_LIMIT_PER_HOUR=10
AI_RATE_LIMIT_PER_MINUTE=3
