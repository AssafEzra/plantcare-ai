# PlantCare AI — environment variable NAMES only. Never commit real values.
# Copy to .env and fill in from your DEV Supabase project.
# See docs/ENVIRONMENTS.md for which environment owns which value.

# --- Application ---
APP_ENV=development
APP_DEBUG=true
DEFAULT_TIMEZONE=Asia/Jerusalem
DEFAULT_CONTENT_LANGUAGE=he

# --- Supabase (DEV project only for local development) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=plant-images

# --- AI provider ---
AI_PROVIDER=anthropic
AI_API_KEY=
IDENTIFICATION_MODEL=
KNOWLEDGE_MODEL=
CARE_MODEL=
HEALTH_MODEL=
AI_REQUEST_TIMEOUT_SECONDS=90
AI_MAX_STRUCTURED_RETRIES=2

# --- Email (Resend). Optional: falls back to a null provider when unset. ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Internal scheduler tick endpoint ---
INTERNAL_TICK_SECRET=

# --- API surface consumed by the Streamlit UI ---
API_BASE_URL=http://localhost:8000

# --- Rate limits for AI-triggering endpoints (A14) ---
AI_RATE_LIMIT_PER_HOUR=10
AI_RATE_LIMIT_PER_MINUTE=3
