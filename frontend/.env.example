# Copy to .env.local and fill in. The anon key is the PUBLIC key - it is shipped
# to every browser and is safe here. Never put SUPABASE_SERVICE_ROLE_KEY in a
# VITE_ variable: anything VITE_-prefixed is bundled into the client.
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key>

# Leave empty in development: vite.config.ts proxies /v1 to the API, so the
# browser sees one origin and needs no CORS configuration.
VITE_API_BASE_URL=
